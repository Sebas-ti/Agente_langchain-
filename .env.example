# Obtén tu API Key gratuita de Google Gemini en: https://aistudio.google.com/apikey
GOOGLE_API_KEY="tu_api_key_aqui"

# Modelo de Gemini a utilizar (ej. gemini-2.5-flash, gemini-2.5-pro)
GEMINI_MODEL="gemini-2.5-flash"

